{
  "name": "@redopjs/redop",
  "version": "0.1.6",
  "description": "Runtime-agnostic TypeScript framework for production MCP servers",
  "keywords": [
    "bun",
    "cloudflare",
    "framework",
    "mcp",
    "model-context-protocol",
    "nodejs",
    "typescript",
    "vercel"
  ],
  "homepage": "https://redop.useagents.site",
  "repository": {
    "type": "git",
    "url": "https://github.com/redopjs/redop.git"
  },
  "bugs": {
    "url": "https://github.com/redopjs/redop/issues"
  },
  "author": {
    "name": "Evans Maina",
    "url": "https://github.com/evansso"
  },
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cloudflare": {
      "types": "./dist/cloudflare.d.ts",
      "default": "./dist/cloudflare.js"
    },
    "./vercel": {
      "types": "./dist/vercel.d.ts",
      "default": "./dist/vercel.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "bun run clean && bun run ./scripts/build.ts && tsc -p tsconfig.build.json",
    "build:js": "bun run clean && bun run ./scripts/build.ts",
    "build:types": "tsc -p tsconfig.build.json",
    "test": "bun test",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.13.10",
    "typescript": "^5.4.0"
  }
}
